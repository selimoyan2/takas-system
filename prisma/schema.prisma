generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==================== NEXTAUTH MODELS ====================
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==================== JETSWAP USER MODEL ====================
enum UserRole {
  STANDARD
  VERIFIED
  ADMIN
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  password        String?
  emailVerified   DateTime?
  phone           String?  @unique
  phoneVerified   Boolean  @default(false)
  name            String?
  username        String?  @unique
  avatarUrl       String?
  role            UserRole @default(STANDARD)

  // Konum bilgileri
  country String  @default("Turkey")
  region  String?
  city    String?

  // JetTrust güven puanı
  jetTrustScore Int @default(50)

  // İstatistikler
  completedSwaps  Int @default(0)
  successfulSwaps Int @default(0)
  cancelledSwaps  Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  accounts           Account[]
  sessions           Session[]
  products           Product[]
  swapPreferences    SwapPreference?
  offersAsSender     TradeOffer[] @relation("TradeOfferSender")
  offersAsReceiver   TradeOffer[] @relation("TradeOfferReceiver")
  messagesAsSender   Message[]    @relation("MessageSender")
  messagesAsReceiver Message[]    @relation("MessageReceiver")
  favorites          Favorite[]
  reviewsWritten     Review[]     @relation("ReviewsWritten")
  reviewsReceived    Review[]     @relation("ReviewsReceived")
  reports            Report[]
  notifications      Notification[]

  @@map("users")
}

// ==================== JETMATCH & MATCHING MODELS ====================
model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  icon        String?
  image       String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  products      Product[]
  subcategories Subcategory[]

  @@map("categories")
}

model Subcategory {
  id         String   @id @default(cuid())
  name       String
  slug       String   @unique
  categoryId String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  category Category  @relation(fields: [categoryId], references: [id])
  products Product[]

  @@map("subcategories")
}

model Brand {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logoUrl   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  products Product[]

  @@map("brands")
}

model SwapPreference {
  id                  String   @id @default(cuid())
  userId              String   @unique
  preferredCategories Json
  maxTradeDistance    Int?
  openToOtherOffers   Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("swap_preferences")
}

// ==================== PRODUCTS & PORTFOLIO ====================
enum ProductStatus {
  DRAFT
  ACTIVE
  EXCHANGED
  ARCHIVED
}

model Product {
  id          String  @id @default(cuid())
  title       String
  slug        String  @unique
  description String?

  // Kategori bilgileri
  categoryId    String
  subcategoryId String?
  brandId       String?
  userId        String

  // Ürün özellikleri
  condition        String
  conditionDetails String?
  year             Int?

  // Konum
  country String  @default("Turkey")
  region  String?
  city    String?

  // Fotoğraflar
  primaryImageId String?

  status     ProductStatus @default(DRAFT)
  isVerified Boolean       @default(false)

  views     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  category      Category     @relation(fields: [categoryId], references: [id])
  subcategory   Subcategory? @relation(fields: [subcategoryId], references: [id])
  brand         Brand?       @relation(fields: [brandId], references: [id])
  productImages ProductImage[]
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  favorites     Favorite[]
  reviews       Review[]
  matchesAsFirst  Match[] @relation("MatchProduct1")
  matchesAsSecond Match[] @relation("MatchProduct2")

  @@map("products")
}

model ProductImage {
  id        String   @id @default(cuid())
  imageUrl  String
  altText   String?
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)
  productId String
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

// ==================== TRADE OFFERS & MESSAGES ====================
enum TradeOfferStatus {
  PENDING
  VIEWED
  NEGOTIATING
  COUNTERED
  ACCEPTED
  REJECTED
  WITHDRAWN
  EXCHANGED
}

model TradeOffer {
  id          String @id @default(cuid())
  senderId    String
  receiverId  String

  offeredProductIds   Json
  requestedProductIds Json?

  status TradeOfferStatus @default(PENDING)

  initialMessage  String?
  lastMessageAt   DateTime?
  respondedAt     DateTime?
  contactUnlockedAt   DateTime?
  exchangeConfirmedAt DateTime?

  isCounterOffer Boolean @default(false)
  parentOfferId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sender   User      @relation("TradeOfferSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User      @relation("TradeOfferReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([senderId, status])
  @@index([receiverId, status])
  @@map("trade_offers")
}

model Message {
  id           String   @id @default(cuid())
  tradeOfferId String?
  senderId     String
  receiverId   String
  content      String
  isSystem     Boolean  @default(false)
  read         Boolean  @default(false)
  createdAt    DateTime @default(now())

  tradeOffer TradeOffer? @relation(fields: [tradeOfferId], references: [id])
  sender     User        @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User        @relation("MessageReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([tradeOfferId, createdAt])
  @@map("messages")
}

// ==================== MATCHING & JETMATCH ====================
enum MatchType {
  MUTUAL
  ONE_WAY
  CHAIN
}

model Match {
  id                 String    @id @default(cuid())
  productId1         String
  productId2         String?
  matchType          MatchType @default(MUTUAL)
  compatibilityScore Int
  isPerfectMatch     Boolean   @default(false)
  source             String?
  viewedAt           DateTime?
  createdAt          DateTime  @default(now())

  product1 Product  @relation("MatchProduct1", fields: [productId1], references: [id])
  product2 Product? @relation("MatchProduct2", fields: [productId2], references: [id])

  @@unique([productId1, productId2, matchType])
  @@map("matches")
}

// ==================== FAVORITES & REVIEWS ====================
model Favorite {
  id           String   @id @default(cuid())
  userId       String
  productId    String?
  tradeOfferId String?
  createdAt    DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
  @@map("favorites")
}

enum ReviewType {
  SWAP
  PRODUCT
  USER
}

model Review {
  id           String     @id @default(cuid())
  reviewerId   String
  revieweeId   String?
  productId    String?
  tradeOfferId String?
  type         ReviewType @default(SWAP)
  rating       Int
  title        String?
  content      String?
  isVerified   Boolean    @default(false)
  createdAt    DateTime   @default(now())

  reviewer User     @relation("ReviewsWritten", fields: [reviewerId], references: [id])
  reviewee User?    @relation("ReviewsReceived", fields: [revieweeId], references: [id])
  product  Product? @relation(fields: [productId], references: [id])

  @@map("reviews")
}

// ==================== REPORTS & MODERATION ====================
enum ReportStatus {
  PENDING
  REVIEWING
  RESOLVED
  DISMISSED
}

model Report {
  id         String       @id @default(cuid())
  reporterId String
  targetId   String?
  targetType String
  reason     String
  details    String?
  status     ReportStatus @default(PENDING)
  resolvedAt DateTime?
  resolvedBy String?
  createdAt  DateTime     @default(now())

  reporter User @relation(fields: [reporterId], references: [id])

  @@map("reports")
}

// ==================== NOTIFICATIONS ====================
enum NotificationType {
  NEW_MATCH
  OFFER_RECEIVED
  OFFER_ACCEPTED
  CONTACT_UNLOCKED
  MESSAGE
  SWAP_COMPLETED
  REVIEW_RECEIVED
  SYSTEM
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String?
  relatedId String?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}
